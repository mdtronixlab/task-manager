--- a/apps/web/src/styles/index.css
+++ b/apps/web/src/styles/index.css
@@ -300,3 +300,150 @@ body {
   outline: 2px solid var(--color-primary);
   outline-offset: 2px;
 }
+
+/* ==========================================================================
+   Motion
+   Small, reusable keyframes + utility classes rather than a new dependency
+   (framer-motion etc.) — consistent with this app's plain-CSS approach
+   elsewhere (animate-spin on LoadingState, transition-colors throughout).
+   ========================================================================== */
+
+@keyframes fade-in-up {
+  from {
+    opacity: 0;
+    transform: translateY(6px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes fade-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+
+@keyframes scale-in {
+  from {
+    opacity: 0;
+    transform: scale(0.96);
+  }
+  to {
+    opacity: 1;
+    transform: scale(1);
+  }
+}
+
+@keyframes fade-out {
+  from {
+    opacity: 1;
+  }
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes scale-out {
+  from {
+    opacity: 1;
+    transform: scale(1);
+  }
+  to {
+    opacity: 0;
+    transform: scale(0.96);
+  }
+}
+
+@keyframes toast-in {
+  from {
+    opacity: 0;
+    transform: translateY(8px) scale(0.98);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0) scale(1);
+  }
+}
+
+@keyframes toast-out {
+  from {
+    opacity: 1;
+    transform: translateY(0) scale(1);
+  }
+  to {
+    opacity: 0;
+    transform: translateY(4px) scale(0.98);
+  }
+}
+
+.animate-fade-in-up {
+  animation: fade-in-up 0.4s ease-out backwards;
+}
+
+.animate-fade-in {
+  animation: fade-in 0.2s ease-out backwards;
+}
+
+.animate-scale-in {
+  animation: scale-in 0.18s ease-out backwards;
+}
+
+.animate-fade-out {
+  animation: fade-out 0.18s ease-in forwards;
+}
+
+.animate-scale-out {
+  animation: scale-out 0.16s ease-in forwards;
+}
+
+.animate-toast-in {
+  animation: toast-in 0.25s ease-out backwards;
+}
+
+.animate-toast-out {
+  animation: toast-out 0.2s ease-in forwards;
+}
+
+/* Stagger a static row of children (dashboard KPI tiles) by position
+   instead of prop-drilling an index into StatTile/CompletionMeter. */
+.stagger-children > * {
+  animation: fade-in-up 0.4s ease-out backwards;
+}
+.stagger-children > *:nth-child(1) {
+  animation-delay: 0ms;
+}
+.stagger-children > *:nth-child(2) {
+  animation-delay: 40ms;
+}
+.stagger-children > *:nth-child(3) {
+  animation-delay: 80ms;
+}
+.stagger-children > *:nth-child(4) {
+  animation-delay: 120ms;
+}
+.stagger-children > *:nth-child(5) {
+  animation-delay: 160ms;
+}
+.stagger-children > *:nth-child(6) {
+  animation-delay: 200ms;
+}
+.stagger-children > *:nth-child(7) {
+  animation-delay: 240ms;
+}
+
+/* rules.md §10 accessibility: motion must be easy to turn off. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.001ms !important;
+    scroll-behavior: auto !important;
+  }
+}
