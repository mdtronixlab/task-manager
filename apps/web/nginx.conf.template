# SPA fallback — the container equivalent of apps/web/public/_redirects
# (Cloudflare Pages' own mechanism for the same problem): react-router's
# BrowserRouter (src/main.jsx) means every real route only exists in JS, so
# a direct link or refresh on e.g. /dashboard 404s without this.
#
# .template + envsubst: the base nginx image renders this into
# /etc/nginx/conf.d/default.conf at container startup, substituting
# ${API_UPSTREAM} (set by detect-api-upstream.envsh, run just before) —
# see that file for why a static `api:4000` hostname isn't reliable across
# both deployment paths this app ships (docker-compose.yml vs CasaOS's
# Custom Install). Only variables matching an actual environment variable
# get substituted, so nginx's own runtime `$vars` (`$uri`, `$host`, ...)
# below pass through untouched.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # nginx's own default (1m) is well under the api container's Express
    # body limit (3mb, apps/api/src/app.js) — Settings > Branding's logo
    # upload (base64-encoded JSON, up to ~2MB image => ~2.7MB payload)
    # would otherwise get rejected by nginx itself with an HTML 413 page
    # before ever reaching the app, which apps/web/src/services/api.js
    # then reports as "The server returned an unexpected response" (a
    # JSON-parse failure) rather than the real cause.
    client_max_body_size 4m;

    # Same-origin reverse proxy to the api service. apps/web/src/services/
    # api.js already calls paths like `/api/tasks`, so with VITE_API_URL
    # left empty (docker-compose.yml's default) this makes the frontend
    # work unmodified from *any* origin it's reached at — localhost, a
    # LAN/Tailscale IP, or a real domain through a tunnel — without a
    # rebuild per origin, and without the browser ever making a
    # cross-origin request (so CORS_ORIGIN stops mattering for normal use;
    # it's only a fallback for anyone hitting the api container's own
    # published port directly).
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Fingerprinted assets (Vite's content-hashed filenames) are safe to
    # cache hard; index.html itself must not be, or a redeploy wouldn't be
    # visible until the cache expired.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The Push API service worker (apps/web/public/sw.js, registered by
    # usePushNotifications.js). Unlike /assets/, this filename never
    # changes, so with no explicit header here nginx falls back to
    # heuristic caching — a browser could keep serving a stale sw.js for a
    # while after a redeploy, silently missing fixes to the push/
    # notificationclick handlers. Forcing revalidation on every load keeps
    # it in step with each deploy at negligible cost (it's a few hundred
    # bytes).
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    # manifest.webmanifest (usePwaInstall.js's installability, via
    # index.html's <link rel="manifest">) — nginx's bundled mime.types has
    # no entry for this extension, so without an explicit type it's served
    # as application/octet-stream, which some browsers refuse to treat as a
    # valid web app manifest. Same no-cache reasoning as sw.js above.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }
}
