// Organisation Task Manager — database schema.
// Field names mirror documents/System Architecture — Organisation Task
// Manager.md §5–10 exactly (rules.md §16: column/field names are part of
// the application contract). Each model has a Prisma-internal autoincrement
// `id` (never exposed) plus a stable, application-generated string ID
// (userId/taskId/...), per rules.md §17.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// rules.md §7 — initial roles.
// STAFF | SUPER_ADMIN
model User {
  id           Int      @id @default(autoincrement())
  userId       String   @unique
  name         String
  email        String   @unique
  role         String
  departmentId String?
  designation  String?
  avatar       String?
  // WhatsApp number (digits, optionally with a leading "+"; country code
  // required — e.g. "917978381201") an admin sets in Team management.
  // Presence of this field is what enrolls a user in WhatsApp notifications
  // (whatsappService.js) — no separate opt-in flag, unlike PushSubscription
  // which is browser-permission-driven instead.
  phone        String?
  // Comma-separated day codes from config.js's WEEKDAYS (e.g. "SUN,SAT") —
  // this person's regular days off. whatsappService.js's sendToUser skips
  // every automatic/broadcast send (not a Super Admin's manual test) on a
  // day listed here. null/empty = no weekly off.
  weeklyOff    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department          Department?          @relation(fields: [departmentId], references: [departmentId])
  tasks               Task[]
  activityLogs        ActivityLog[]
  pushSubscriptions   PushSubscription[]
  whatsAppMessageLogs WhatsAppMessageLog[]
  visibleAdminGrants  AdminTaskVisibility[] @relation("AdminVisibilityViewer")
  grantedToAdmins     AdminTaskVisibility[] @relation("AdminVisibilityTarget")

  @@map("users")
}

// Super Admin-controlled: which other ADMIN-role users' tasks a given Admin
// is allowed to see on the org-wide Tasks list (extends rules.md §14 — an
// Admin's view of *another Admin's* tasks is now opt-in per pair, granted
// here; Staff-owned tasks and a Super Admin's own view stay unrestricted,
// see taskService.js's getTasks). One row = "viewer may see target's tasks".
model AdminTaskVisibility {
  id        Int      @id @default(autoincrement())
  viewerId  String
  targetId  String
  createdAt DateTime @default(now())

  viewer User @relation("AdminVisibilityViewer", fields: [viewerId], references: [userId], onDelete: Cascade)
  target User @relation("AdminVisibilityTarget", fields: [targetId], references: [userId], onDelete: Cascade)

  @@unique([viewerId, targetId])
  @@map("admin_task_visibility")
}

// rules.md §20/§21 — allowed status/priority values enforced in application
// code (src/config.js), not at the schema level, so validation errors stay
// under our own control (rules.md §27).
model Task {
  id          Int       @id @default(autoincrement())
  taskId      String    @unique
  userId      String
  taskDate    String
  title       String
  description String?
  categoryId  String?
  priority    String    @default("MEDIUM")
  status      String    @default("PENDING")
  // "HH:mm" 24h, org-local — optional (prd.md §25 V2 "Due times"). Drives
  // taskDueReminderService's push at that minute; dueReminderSentAt guards
  // against sending it twice.
  dueTime           String?
  dueReminderSentAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  // Best-effort GPS fix taken client-side at the moment a staff member
  // completes their own task (never on an admin-driven status change — only
  // self-completion ever reaches this). Null whenever permission was denied,
  // the browser timed out, or the device doesn't support geolocation —
  // completion is never blocked on this. Visible to Admin/Super Admin only
  // (taskService.js's shapeTask), never surfaced back to the staff member.
  completionLat      Float?
  completionLng      Float?
  completionAccuracy Float? // meters, from GeolocationPosition.coords.accuracy
  // Soft delete (rules.md §25) — kept for administrative auditing instead of
  // a hard delete; excluded from every normal task query (deletedAt: null).
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [userId])
  category     Category?     @relation(fields: [categoryId], references: [categoryId])
  activityLogs ActivityLog[]

  @@map("tasks")
}

model Category {
  id          Int      @id @default(autoincrement())
  categoryId  String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  tasks Task[]

  @@map("categories")
}

model Department {
  id          Int      @id @default(autoincrement())
  departmentId String  @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  users User[]

  @@map("departments")
}

// rules.md §26 — every important operation must be traceable.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  logId     String   @unique
  userId    String
  taskId    String?
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
  metadata  String   @default("{}")

  user User  @relation(fields: [userId], references: [userId])
  task Task? @relation(fields: [taskId], references: [taskId])

  @@map("activity_log")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

// Web Push plumbing (no automatic triggers yet — see src/services/
// pushService.js). One row per browser/device a user has enabled
// notifications on, keyed on `endpoint` (globally unique per browser
// install) rather than userId, since a user can have several.
model PushSubscription {
  id             Int      @id @default(autoincrement())
  subscriptionId String   @unique
  userId         String
  endpoint       String   @unique
  p256dh         String
  auth           String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [userId])

  @@map("push_subscriptions")
}

// One row per outbound WhatsApp send attempt (whatsappService.js's
// sendToUser) — sent or failed, whichever it was. Settings > WhatsApp's
// "Recent messages" log reads this so delivery status is visible in the
// app instead of only ever reaching the server console (whatsappService.js
// previously only console.error'd a failure).
//
// "Delivered"/"read" WhatsApp receipts aren't tracked here — OpenWA's HTTP
// response only confirms the send request itself succeeded or failed, not
// what happens to it after; status is SENT (request accepted) or FAILED
// (OpenWA/HTTP error, or no usable number).
model WhatsAppMessageLog {
  id         Int      @id @default(autoincrement())
  logId      String   @unique
  userId     String
  phone      String
  kind       String
  templateId String?
  status     String
  error      String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [userId])

  @@map("whatsapp_message_logs")
  @@index([createdAt])
}

// Backs generateId() (src/lib/ids.js) — a dedicated counters table instead
// of overloading Settings, now that a real transactional database makes
// this straightforward (an improvement over the Apps Script version, which
// had to stuff counters into the Settings sheet).
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}
