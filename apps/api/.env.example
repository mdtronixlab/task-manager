DATABASE_URL="file:./dev.db"
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Firebase Authentication (Google Sign-In) — identity only.
FIREBASE_PROJECT_ID=task-manager-app-2d85c

# Path to a Firebase service-account JSON key (Firebase Console > Project
# Settings > Service Accounts > Generate new private key). Required by
# firebase-admin to verify ID tokens. Never commit the key file itself.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional — bootstraps one Super Admin on first `npm run db:seed` so
# there's someone who can log in immediately.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Web Push — generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Optional at startup; only required once a /api/push route is called.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mdtronix.lab@gmail.com

# WhatsApp — a self-hosted OpenWA instance (https://github.com — dashboard
# has Sessions, API Keys). OPENWA_SESSION_ID is the session's UUID (Sessions
# > a session > Session Details), not its human-readable name. Optional;
# only required once a WhatsApp message is actually sent. If apps/api runs
# in a container and OpenWA doesn't, point this at an address the container
# can actually reach (the host's LAN/Tailscale IP) — not localhost.
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# Optional — an OpenWA Templates entry's id (Sessions > Templates) to use
# for the morning "add your task" reminder instead of the plain built-in
# wording. Leave blank to use the built-in wording.
OPENWA_TASK_REMINDER_TEMPLATE_ID=
