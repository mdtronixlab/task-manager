# Optional root-level overrides for `docker compose` (see docker-compose.yml
# and README.md's Docker section) — NOT the per-app apps/api/.env.example /
# apps/web/.env.example, which hold each app's own runtime config and are
# always required. Everything below is optional; compose falls back to
# sensible localhost defaults when this file doesn't exist at all.
#
# cp .env.example .env, then fill in only what your deployment needs.

# Identifies this stack's persisted data under /DATA/AppData/$AppID (CasaOS's
# own convention — see docker-compose.yml's top-of-file note). Only matters
# if you want a name other than the "task-manager" default, e.g. running two
# copies of this stack side by side on the same CasaOS host.
AppID=task-manager

# Set these when the app is reached from somewhere other than
# http://localhost:8080 — a LAN/Tailscale IP, a real domain, etc. Getting
# CORS_ORIGIN wrong fails every API call (not loudly) the moment you try to
# sign in; VITE_API_URL is baked into the web build, so it has to be right
# *before* `docker compose build`, not fixed up afterward.
# VITE_API_URL=http://100.x.x.x:4000
# CORS_ORIGIN=http://100.x.x.x:8080

# Baked into the web build at compose build-time (see apps/web/.env.example
# for what each of these is) — set here instead of apps/web/.env only if you
# want compose to read them without `--env-file apps/web/.env`.
# VITE_APP_NAME=Organisation Task Manager
# VITE_APP_ENV=production
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=task-manager-app-2d85c
# VITE_FIREBASE_APP_ID=
